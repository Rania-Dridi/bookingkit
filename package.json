{
  "name": "bookingkit",
  "version": "1.0.0",
  "description": "Appointment booking platform for salons and clinics (TypeScript, Express, SQLite)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
